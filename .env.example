MIX_ENV=prod
DATABASE_URL=ecto://postgres:postgres@postgres/gx_portfolio_intelligence
SECRET_KEY_BASE=replace-with-at-least-64-random-bytes
GX_PI_API_TOKEN=replace-with-long-random-token
PORT=4010
PHX_HOST=localhost

# TradingAgents is invoked with an executable and argv; no shell is used.
TRADING_AGENTS_ROOT=/opt/trading_agents
TRADING_AGENTS_PYTHON=/opt/trading_agents/.venv/bin/python
GX_PI_ARTIFACT_ROOT=/data/gx-pi/artifacts
TRADING_AGENTS_TIMEOUT_MS=900000
TRADING_AGENTS_FULL_STAGE_TIMEOUT_MS=1800000
FULL_STAGE_CLAIM_LEASE_SECONDS=2100
TRADING_AGENTS_FULL_LLM_MAX_RETRIES=0
TRADING_AGENTS_FULL_MAX_TOOL_ROUNDS=8
TRADING_AGENTS_MAX_OUTPUT_BYTES=2000000

# TradingAgents inherits this process environment. V1 universe selection is
# PostgreSQL-only and the database user must be read-only.
GX_DATA_TRANSPORT=postgres
GX_MARKET_INFO_DATABASE_URL=postgresql://readonly_user:replace-me@gx-postgres:5432/g_market_info
GX_MARKET_INFO_EXPECTED_DB=g_market_info

# Quick/deep model and collector credentials are intentionally blank in this
# template. Full Analysis uses Quick for analyst work and Deep for the
# research/trader/risk roles. Provision both role keys through the deployment
# secret manager (or use the provider's canonical key such as OPENAI_API_KEY).
TRADINGAGENTS_QUICK_LLM_PROVIDER=openai
TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
TRADINGAGENTS_QUICK_LLM_BASE_URL=
TRADINGAGENTS_QUICK_LLM_API_KEY=
TRADINGAGENTS_DEEP_LLM_PROVIDER=openai
TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.5
TRADINGAGENTS_DEEP_LLM_BASE_URL=
TRADINGAGENTS_DEEP_LLM_API_KEY=
TRADINGAGENTS_FIREANT_AUTHORIZED=false
TRADINGAGENTS_FIREANT_HOSTED_LLM_AUTHORIZED=false
FIREANT_ACCESS_TOKEN=
FIREANT_ARCHIVE_ENCRYPTION_KEY=
TRADINGAGENTS_VN_SOCIAL_TICKERS=HPG,VIC,VHM,SHB,VIX

# Enable each RSS source only after APG has approved automated collection and
# retention. Enable its hosted-LLM flag separately only after approval to send
# RSS title/summary to the configured remote Quick LLM.
TRADINGAGENTS_VN_MEDIA_PROVIDERS=cafef_rss,vnexpress_rss
TRADINGAGENTS_CAFEF_RSS_AUTHORIZED=false
TRADINGAGENTS_CAFEF_HOSTED_LLM_AUTHORIZED=false
TRADINGAGENTS_VNEXPRESS_RSS_AUTHORIZED=false
TRADINGAGENTS_VNEXPRESS_HOSTED_LLM_AUTHORIZED=false
TRADINGAGENTS_VN_MEDIA_TICKERS=HPG,VIC,VHM,SHB,VIX
VN_MEDIA_ARCHIVE_ENCRYPTION_KEY=

# Keep all Python-owned durable archives on the persistent artifact volume.
TRADINGAGENTS_SOCIAL_ARCHIVE_PATH=/data/gx-pi/artifacts/raw/vn_social.sqlite3
TRADINGAGENTS_VN_MEDIA_ARCHIVE_PATH=/data/gx-pi/artifacts/raw/vn_media.sqlite3
TRADINGAGENTS_VN_MACRO_ARCHIVE_PATH=/data/gx-pi/artifacts/raw/vn_macro.sqlite3

RAG_SERVICE_URL=http://simple-rag:8000
RAG_SERVICE_API_KEY=replace-with-shared-rag-token
RAG_TIMEOUT_MS=60000
RAG_CLAIM_LEASE_SECONDS=120
RAG_ANSWER_NUM_PREDICT=2048
# Advanced/Agentic answer only; accepted range is 256..1024.
RAG_ADVANCED_ANSWER_NUM_PREDICT=1024
RAG_REWRITE_NUM_PREDICT=96

# Keep false until a successful manual 5/50/500 rollout.
GX_PI_CRON_ENABLED=false
GX_PI_TREND_ENABLED=false
# EOD full analysis is globally enabled only by this flag. Ad-hoc requests use
# analysis_depth=full independently and include every requested ticker.
GX_PI_FULL_ANALYSIS_ENABLED=false
GX_PI_FULL_ANALYSIS_LIMIT=5
GX_PI_FULL_ANALYSIS_BACKLOG_WARNING_THRESHOLD=20
GX_PI_FULL_ANALYSIS_PINNED_TICKERS=
OBAN_CONTROL_CONCURRENCY=1
OBAN_COLLECTORS_CONCURRENCY=1
OBAN_RESEARCH_CONCURRENCY=4
OBAN_TREND_CONCURRENCY=1
OBAN_FULL_ANALYSIS_CONCURRENCY=2
OBAN_RAG_CONCURRENCY=2
OBAN_MAINTENANCE_CONCURRENCY=1

GX_PI_WEBHOOK_URL=
GX_PI_WEBHOOK_TOKEN=
GX_PI_DISK_ALERT_PERCENT=85
POOL_SIZE=15
